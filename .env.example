# Public site settings for the Sojao AI marketing site.
# Leave a value empty to hide that item (no placeholders are shown).

# Canonical site URL, e.g. https://www.example.com
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is empty.
NEXT_PUBLIC_SITE_URL=

# Company details shown in the footer, contact page and legal pages
NEXT_PUBLIC_LEGAL_NAME=Nexthorne
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Social profiles (footer + contact page). Hidden when empty.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form: messages are POSTed as JSON to this webhook
# (Zapier, Make, Slack, or your email provider). Server-only, never exposed.
CONTACT_WEBHOOK_URL=
